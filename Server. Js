// Helm Link Unit 201 - server penyambung ruangan (signaling WebRTC)
const http = require('http');
const fs = require('fs');
const path = require('path');
const { WebSocketServer } = require('ws');

const PORT = process.env.PORT || 3000;
const MAX = 6; // maksimal helm per ruangan
const PUBLIC = path.join(__dirname, 'public');
const TYPES = { '.html': 'text/html; charset=utf-8', '.css': 'text/css; charset=utf-8', '.js': 'application/javascript; charset=utf-8' };

const server = http.createServer((req, res) => {
  if (req.url === '/ice') {
    const ice = [{ urls: 'stun:stun.l.google.com:19302' }];
    if (process.env.TURN_URL) {
      ice.push({ urls: process.env.TURN_URL, username: process.env.TURN_USER, credential: process.env.TURN_PASS });
    }
    res.writeHead(200, { 'Content-Type': 'application/json' });
    return res.end(JSON.stringify(ice));
  }
  let url = req.url.split('?')[0];
  if (url === '/') url = '/visor.html';
  if (url === '/visor') url = '/visor.html';
  const file = path.normalize(path.join(PUBLIC, url));
  const type = TYPES[path.extname(file)];
  if (!file.startsWith(PUBLIC + path.sep) || !type) {
    res.writeHead(404); return res.end('Tidak ditemukan');
  }
  fs.readFile(file, (err, data) => {
    if (err) { res.writeHead(404); return res.end('Tidak ditemukan'); }
    res.writeHead(200, { 'Content-Type': type });
    res.end(data);
  });
});

const wss = new WebSocketServer({ server });
const rooms = new Map();
let counter = 0;

function send(ws, obj) {
  if (ws.readyState === 1) ws.send(JSON.stringify(obj));
}

wss.on('connection', (ws) => {
  ws.on('message', (raw) => {
    let m;
    try { m = JSON.parse(raw); } catch (e) { return; }

    if (m.type === 'join' && !ws.room) {
      const room = String(m.room || '').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 16) || 'LEGIUN2';
      const set = rooms.get(room) || new Map();
      if (set.size >= MAX) return send(ws, { type: 'full' });
      ws.id = 'p' + (++counter);
      ws.room = room;
      ws.name = String(m.name || 'Unit').slice(0, 16);
      ws.info = String(m.info || '').slice(0, 24);
      ws.photo = (typeof m.photo === 'string' && m.photo.length < 40000 && /^data:image\/jpeg;base64,[A-Za-z0-9+\/=]+$/.test(m.photo)) ? m.photo : '';
      const peers = Array.from(set.values()).map((p) => ({ id: p.id, name: p.name, info: p.info, photo: p.photo }));
      set.set(ws.id, ws);
      rooms.set(room, set);
      send(ws, { type: 'joined', id: ws.id, room: room, peers: peers });
      set.forEach((p) => { if (p !== ws) send(p, { type: 'peer-joined', id: ws.id, name: ws.name, info: ws.info, photo: ws.photo }); });
    } else if (m.type === 'signal' && ws.room) {
      const set = rooms.get(ws.room);
      const target = set && set.get(m.to);
      if (target) send(target, { type: 'signal', from: ws.id, name: ws.name, info: ws.info, data: m.data });
    }
  });

  ws.on('close', () => {
    if (!ws.room) return;
    const set = rooms.get(ws.room);
    if (!set) return;
    set.delete(ws.id);
    set.forEach((p) => send(p, { type: 'peer-left', id: ws.id }));
    if (!set.size) rooms.delete(ws.room);
  });
});

server.listen(PORT, '0.0.0.0', () => console.log('Helm Link berjalan di port ' + PORT));
